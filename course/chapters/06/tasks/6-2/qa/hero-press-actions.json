[
  [
    "until",
    "window.tilingLab && tilingLab.scene.stats().frameCount > 1"
  ],
  [
    "click",
    "[data-stage=press]"
  ],
  [
    "scroll",
    "#pressRun"
  ],
  [
    "click",
    "#pressRun"
  ],
  [
    "wait",
    3500
  ],
  [
    "scroll",
    "#pressRun"
  ],
  [
    "click",
    "#pressRun"
  ],
  [
    "eval",
    "if(tilingLab.snapshot().readings.press.passed)throw Error('untouched shallow position passed');'shallow press insufficient'"
  ],
  [
    "click",
    "[data-mode=force]"
  ],
  [
    "click",
    "#pressMore summary"
  ],
  [
    "click",
    "#raisedBase"
  ],
  [
    "click",
    "#pressMore summary"
  ],
  [
    "scroll",
    "#pressRun"
  ],
  [
    "click",
    "#pressRun"
  ],
  [
    "until",
    "tilingLab.snapshot().readings.press.forceOK && tilingLab.snapshot().readings.press.onTarget",
    20000
  ],
  [
    "scroll",
    "#ruler"
  ],
  [
    "click",
    "#ruler"
  ],
  [
    "eval",
    "if(!tilingLab.snapshot().state.press.checked||tilingLab.snapshot().view!=='section')throw Error('ruler action missed');'ruler applied'"
  ],
  [
    "wait",
    600
  ],
  [
    "shot",
    "qa/hero-artifacts/force-ok-height-wrong.png",
    "#app",
    1
  ],
  [
    "scroll",
    "#finish"
  ],
  [
    "click",
    "#finish"
  ],
  [
    "eval",
    "(()=>{const s=tilingLab.snapshot();if(s.state.done.press||s.readings.press.heightOK)throw Error('bad height accepted');return 'force alone cannot pass height'})()"
  ],
  [
    "scroll",
    "#rebed"
  ],
  [
    "click",
    "#rebed"
  ],
  [
    "until",
    "!tilingLab.snapshot().state.motion",
    10000
  ],
  [
    "eval",
    "(()=>{const q=document.querySelector('#pressTarget');q.value=320;q.dispatchEvent(new Event('input',{bubbles:true}));return q.value})()"
  ],
  [
    "scroll",
    "#pressRun"
  ],
  [
    "click",
    "#pressRun"
  ],
  [
    "until",
    "tilingLab.snapshot().state.press.damaged",
    20000
  ],
  [
    "shot",
    "qa/hero-artifacts/overpressure.png",
    "#app",
    1
  ],
  [
    "click",
    "[data-stage=grip]"
  ],
  [
    "click",
    "[data-stage=press]"
  ],
  [
    "eval",
    "if(!tilingLab.snapshot().state.press.damaged)throw Error('stage reset lost damage');'overpressure retained across stages'"
  ],
  [
    "scroll",
    "#rebed"
  ],
  [
    "click",
    "#rebed"
  ],
  [
    "until",
    "!tilingLab.snapshot().state.motion",
    10000
  ],
  [
    "eval",
    "(()=>{const q=document.querySelector('#pressTarget');q.value=160;q.dispatchEvent(new Event('input',{bubbles:true}));return q.value})()"
  ],
  [
    "scroll",
    "#pressRun"
  ],
  [
    "click",
    "#pressRun"
  ],
  [
    "until",
    "tilingLab.snapshot().readings.press.passed",
    20000
  ],
  [
    "scroll",
    "#ruler"
  ],
  [
    "click",
    "#ruler"
  ],
  [
    "eval",
    "if(!tilingLab.snapshot().state.press.checked||tilingLab.snapshot().view!=='section')throw Error('ruler action missed');'ruler applied'"
  ],
  [
    "scroll",
    "#finish"
  ],
  [
    "click",
    "#finish"
  ],
  [
    "until",
    "document.querySelector('#summaryDialog').open",
    10000
  ],
  [
    "click",
    "#summaryDialog [data-close]"
  ],
  [
    "scroll",
    "#finish"
  ],
  [
    "click",
    "#finish"
  ],
  [
    "eval",
    "if(tilingLab.snapshot().state.motion||tilingLab.snapshot().readings.sensorForce!==0)throw Error('repeated release or unloaded force');'repeated finish stays unloaded'"
  ],
  [
    "click",
    "#summaryDialog [data-close]"
  ],
  [
    "scroll",
    "#rebed"
  ],
  [
    "click",
    "#rebed"
  ],
  [
    "eval",
    "if(tilingLab.snapshot().readings.sensorForce!==0||tilingLab.snapshot().state.press.checked)throw Error('rebed contact or stale ruler');'rebed resets review and approaches unloaded'"
  ],
  [
    "until",
    "!tilingLab.snapshot().state.motion",
    10000
  ],
  [
    "eval",
    "if(tilingLab.snapshot().state.press.damaged||tilingLab.snapshot().state.press.base)throw Error('rebed incomplete');'PRESS FAILURES AND RECOVERY PASS'"
  ]
]