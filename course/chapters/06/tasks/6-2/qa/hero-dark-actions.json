[
  [
    "until",
    "window.tilingLab && tilingLab.scene.stats().frameCount > 1"
  ],
  [
    "shot",
    "qa/hero-artifacts/overview-dark.png",
    "#app",
    1
  ],
  [
    "click",
    "[data-view=head]"
  ],
  [
    "click",
    "#center"
  ],
  [
    "click",
    "[data-layout=quad]"
  ],
  [
    "wait",
    600
  ],
  [
    "shot",
    "qa/hero-artifacts/contact-dark-4x.png",
    "#heroViewport",
    4,
    [
      310,
      145,
      480,
      260
    ]
  ],
  [
    "click",
    "#explode"
  ],
  [
    "wait",
    600
  ],
  [
    "shot",
    "qa/hero-artifacts/exploded-dark.png",
    "#app",
    1
  ],
  [
    "click",
    "#trial"
  ],
  [
    "eval",
    "if(document.querySelector('#explode').getAttribute('aria-pressed')!=='false')throw Error('moving while exploded');'motion reassembles tool'"
  ],
  [
    "until",
    "!tilingLab.snapshot().state.motion",
    12000
  ],
  [
    "eval",
    "if(!tilingLab.snapshot().state.grip.trial||document.documentElement.dataset.theme!=='dark')throw Error('dark trial failed');'DARK PASS'"
  ]
]
