[
  [
    "until",
    "window.tilingLab && tilingLab.scene.stats().frameCount > 1"
  ],
  [
    "shot",
    "qa/hero-artifacts/mobile-scene.png",
    "#app",
    1
  ],
  [
    "click",
    "#mobileToggle"
  ],
  [
    "shot",
    "qa/hero-artifacts/mobile-controls.png",
    "#app",
    1
  ],
  [
    "click",
    "#trial"
  ],
  [
    "eval",
    "if(document.querySelector('#app').classList.contains('mobile-controls'))throw Error('action hidden by controls'); 'mobile trial reveals scene'"
  ],
  [
    "until",
    "!tilingLab.snapshot().state.motion",
    12000
  ],
  [
    "click",
    "#mobileToggle"
  ],
  [
    "click",
    "#center"
  ],
  [
    "click",
    "[data-layout=quad]"
  ],
  [
    "click",
    "#trial"
  ],
  [
    "until",
    "tilingLab.snapshot().state.grip.trial",
    12000
  ],
  [
    "click",
    "#next"
  ],
  [
    "until",
    "tilingLab.snapshot().state.stage==='align'",
    18000
  ],
  [
    "click",
    "[data-view=top]"
  ],
  [
    "click",
    "#sceneAction"
  ],
  [
    "wait",
    350
  ],
  [
    "shot",
    "qa/hero-artifacts/mobile-alignment.png",
    "#app",
    1
  ],
  [
    "eval",
    "(()=>{const s=tilingLab.snapshot();if(!s.readings.vision.valid||document.documentElement.scrollWidth>innerWidth)throw Error('mobile observation or overflow');return 'MOBILE PASS'})()"
  ]
]
