[
 ["until","window.tilingLab && tilingLab.scene.stats().frameCount > 1"],
 ["click","[data-view=head]"],
 ["wait",700],
 ["shot","qa/hero-artifacts/head-light.png","#app",1],
 ["click","#trial"],
 ["until","tilingLab.snapshot().state.tile.tilt > 2",12000],
 ["shot","qa/hero-artifacts/failed-lift.png","#heroViewport",2],
 ["until","!tilingLab.snapshot().state.motion",15000],
 ["eval","if(tilingLab.snapshot().state.grip.trial)throw Error('eccentric pickup incorrectly passed'); 'failed trial returned to support'"],
 ["click","#center"],
 ["click","[data-layout=quad]"],
 ["click","#explode"],
 ["wait",800],
 ["shot","qa/hero-artifacts/exploded-light.png","#heroViewport",1],
 ["wait",250],
 ["click","#explode"],
 ["click","#trial"],
 ["eval","(()=>{const s=tilingLab.snapshot();if(s.state.motion?.kind!=='trial'||!s.state.motion.success)throw Error('trial setup invalid '+JSON.stringify({grip:s.state.grip,readings:s.readings.grip,motion:s.state.motion}));return 'centered four-cup trial started'})()"],
 ["wait",3500],
 ["eval","JSON.stringify({grip:tilingLab.snapshot().state.grip,motion:tilingLab.snapshot().state.motion,frames:tilingLab.scene.stats().frameCount,hidden:document.hidden,visibility:tilingLab.scene.stats().visible})"],
 ["until","tilingLab.snapshot().state.grip.trial",15000],
 ["click","#transfer"],
 ["until","tilingLab.snapshot().state.stage === 'align'",20000],
 ["click","[data-view=top]"],
 ["click","#recognize"],
 ["wait",700],
 ["shot","qa/hero-artifacts/alignment-before.png","#app",1],
 ["click","#occlude"],
 ["eval","window.observedBefore=JSON.stringify(tilingLab.snapshot().state.align.last); window.actualBefore=tilingLab.snapshot().state.align.ex; 'stored observation'"],
 ["click","#slip"],
 ["eval","(()=>{const s=tilingLab.snapshot();if(s.readings.vision.valid || s.readings.vision.ex!==null || JSON.stringify(s.state.align.last)!==window.observedBefore || s.state.align.ex===window.actualBefore)throw Error('occlusion truth mismatch');return 'occlusion freezes measurement while independent slip changes tile'})()"],
 ["shot","qa/hero-artifacts/occluded-slip.png","#app",1],
 ["click","#occlude"],
 ["eval","if(tilingLab.snapshot().readings.vision.valid)throw Error('clear view needs recognition');'clear view still requires reacquisition'"],
 ["click","#recognize"],
 ["click","#alignRun"],
 ["until","tilingLab.snapshot().readings.vision.aligned",15000],
 ["click","#acceptAlign"],
 ["shot","qa/hero-artifacts/alignment-after.png","#app",1],
 ["click","#toPress"],
 ["until","!tilingLab.snapshot().state.motion",12000],
 ["click","[data-mode=force]"],
 ["click","#pressRun"],
 ["until","tilingLab.snapshot().readings.press.passed",20000],
 ["click","#ruler"],
 ["wait",700],
 ["shot","qa/hero-artifacts/section-pass.png","#app",1],
 ["click","#finish"],
 ["until","document.querySelector('#summaryDialog').open",10000],
 ["eval","(()=>{const s=tilingLab.snapshot();if(!Object.values(s.state.done).every(Boolean)||!document.querySelector('#summaryDialog').open||s.state.attached)throw Error('full workflow incomplete');return 'FULL WORKFLOW PASSED'})()"],
 ["click","#summaryDialog [data-close]"],
 ["click","[data-view=overview]"],
 ["wait",700],
 ["shot","qa/hero-artifacts/completed-floor.png","#app",1],
 ["eval","JSON.stringify({scene:tilingLab.scene.stats(),done:tilingLab.snapshot().state.done,overflow:document.documentElement.scrollWidth>innerWidth})"]
]
