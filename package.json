{
  "name": "construction-robotics-course",
  "private": true,
  "version": "1.0.0",
  "description": "Offline construction robotics course, eight chapters; active tasks from course/catalog.json",
  "scripts": {
    "build": "node scripts/build.mjs all",
    "test": "node scripts/test.mjs",
    "check": "python scripts/check-links.py",
    "verify": "python scripts/verify-project.py",
    "package": "python scripts/package-site.py",
    "serve": "python -m http.server 8765 --bind 127.0.0.1",
    "preview": "python -m http.server 8765 --bind 127.0.0.1 --directory artifacts/site",
    "build:models": "python scripts/build-workshops.py 1-3",
    "deploy": "node scripts/deploy.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "edgeone": "^1.6.47",
    "playwright": "^1.65.0",
    "wrangler": "^4.158.0"
  }
}
